# Copy these into your shell before running nix-darwin commands.
# Example:
#   export NIX_USERNAME="your-username"
#   export NIX_HOSTNAME="your-hostname"
#   export NIX_PROFILE="core"
#   export GIT_NAME="Your Name"
#   export GIT_EMAIL="you@example.com"
# Supported profiles: core, dev, creative

export NIX_USERNAME="akhil"
export NIX_HOSTNAME="Valhalla"
export NIX_PROFILE="core"
export GIT_NAME="Akhil Mulpurii"
export GIT_EMAIL="akhil@example.com"